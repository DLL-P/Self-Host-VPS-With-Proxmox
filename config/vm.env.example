# Copie este arquivo para config/vm.env e ajuste os valores antes de rodar os scripts.
# NUNCA commite o arquivo config/vm.env (ele fica no .gitignore) pois pode conter dados sensíveis.

# --- Identificação da VM ---
VMID=9000
VM_NAME=vps-cliente-jogos
VM_STORAGE=local-lvm          # storage do Proxmox onde o disco vai morar
ISO_STORAGE=local             # storage onde a imagem cloud-init fica
BRIDGE=vmbr0                  # bridge de rede do Proxmox usada pela VM

# --- Recursos da VM (ajuste conforme o jogo/servidor) ---
VM_CORES=4
VM_MEMORY_MB=8192
VM_DISK_GB=60

# --- Imagem base (Debian 12 cloud image) ---
CLOUD_IMAGE_URL="https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2"
CLOUD_IMAGE_FILE="/var/lib/vz/template/iso/debian-12-genericcloud-amd64.qcow2"

# --- Rede ---
# Modo "bridged": a VM recebe IP público diretamente (defina VM_IP/VM_GATEWAY/VM_CIDR)
# Modo "nat": a VM fica em rede interna e o host Proxmox faz NAT/port-forward (script 03)
NETWORK_MODE=bridged          # bridged | nat

VM_IP=203.0.113.10             # IP público da VM (modo bridged) OU IP interno (modo nat, ex: 10.10.10.10)
VM_CIDR=24
VM_GATEWAY=203.0.113.1
DNS_SERVER=1.1.1.1

# Usado apenas no modo "nat": IP público do próprio host Proxmox
HOST_PUBLIC_IP=203.0.113.5
NAT_INTERNAL_BRIDGE=vmbr1      # bridge interna criada só para as VMs (sem IP público)
NAT_SUBNET=10.10.10.0/24
NAT_HOST_GATEWAY_IP=10.10.10.1

# --- Acesso ---
CI_USER=cliente
SSH_PUBLIC_KEY_FILE=~/.ssh/id_rsa.pub   # chave pública do cliente, sem senha configurada por padrão
ADMIN_SSH_SOURCE_IP=0.0.0.0/0           # restrinja para o IP do administrador sempre que possível

# --- Portas do servidor de jogos (separadas por espaço, formato porta/protocolo) ---
# Exemplos: "25565/tcp" (Minecraft Java), "19132/udp" (Minecraft Bedrock), "27015/tcp 27015/udp" (CS2)
GAME_PORTS="25565/tcp"
