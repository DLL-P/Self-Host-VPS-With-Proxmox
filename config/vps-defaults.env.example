# Copie para config/vps-defaults.env e ajuste antes de rodar os scripts.

# Disco mecânico (HD) dedicado ao armazenamento das VPS's.
# NUNCA aponte para o disco onde o SO do host está instalado.
# Confirme com `lsblk -o NAME,SIZE,TYPE,MOUNTPOINT,MODEL` (docs/host-os-install.md).
HDD_DEVICE=/dev/sdb

# Onde o HD é montado e onde ficam as imagens das VPS's.
VPS_STORAGE_MOUNT=/mnt/vps-storage
VPS_STORAGE_POOL=vps-pool

# Rede NAT isolada criada pelo libvirt para as VPS's.
VPS_NETWORK_NAME=vps-net
VPS_NETWORK_CIDR=192.168.150.0/24
VPS_NETWORK_BRIDGE=virbr-vps

# Interface de rede do HOST voltada para o roteador/LAN (usada pelo manage-vps.sh
# port-forward para criar as regras DNAT). Deixe em branco para autodetectar pela
# rota padrão (ip route get 1.1.1.1).
HOST_WAN_IFACE=

# Specs padrão de uma nova VPS (podem ser sobrescritas por flags no create-vps.sh).
DEFAULT_VCPUS=1
DEFAULT_RAM_MB=2048
DEFAULT_DISK_GB=50

# Imagem base (cloud image) usada como template. Baixada uma vez e reaproveitada
# (cada VPS usa um qcow2 com backing file nela, economizando espaço no HD).
BASE_IMAGE_URL=https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-generic-amd64.qcow2
BASE_IMAGE_NAME=debian-12-generic-amd64.qcow2

# Usuário padrão criado dentro de cada VPS via cloud-init.
DEFAULT_VPS_USER=admin
